<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
    ================================================================
    CONCEPTO SOA: Cada servicio tiene su propio pom.xml (build file).
    Esto refleja que cada servicio es una unidad INDEPENDIENTE que
    puede compilarse, empaquetarse y desplegarse por separado.
    ================================================================
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
    </parent>

    <groupId>com.biblioteca</groupId>
    <artifactId>servicio-libros</artifactId>
    <version>1.0.0</version>
    <name>Servicio de Libros - Entity Service SOA</name>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Spring Web: habilita REST Controllers (@RestController, @GetMapping, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
        SpringDoc OpenAPI: genera Swagger UI automáticamente.
        CONCEPTO SOA: equivalente moderno del WSDL.
        Documenta el CONTRATO del servicio en http://localhost:8001/swagger-ui.html
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!-- Actuator: health checks y métricas (/actuator/health) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ── PostgreSQL (Sesiones 17-18) ──────────────────────────────
             Spring Data JPA: abstrae el acceso a la base de datos.
             CONCEPTO SOA: el Entity Service persiste su propio dominio
             de datos — cada servicio tiene su propia base de datos. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
